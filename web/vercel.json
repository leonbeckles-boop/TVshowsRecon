{
  "rewrites": [
    {
      "source": "/shows-like/:slug",
      "destination": "https://whatnext-api.onrender.com/seo-pages/shows-like/:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://whatnext-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}